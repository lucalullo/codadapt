include LICENSE README.md CHANGELOG.md RELEASE_NOTES.md CONTRIBUTING.md SECURITY.md BENCHMARKS.md
include pyproject.toml MANIFEST.in .gitignore
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *.py *.ipynb
recursive-include benchmarks *.py
recursive-include .github *.yml *.yaml
global-exclude *.py[cod] __pycache__ .DS_Store
